* {
    bg: #f5f5f7;
    fg: #1d1d1f;
    muted: #616166;
    accent: #d6e8ff;
    background-color: transparent;
    text-color: @fg;
    border-color: #d1d1d6;
    spacing: 0;
}
window {
    width: 560px;
    location: center;
    anchor: center;
    background-color: @bg;
    border: 2px;
    border-radius: 0px;
}
mainbox { padding: 24px; children: [inputbar, listview]; }
inputbar { padding: 4px 4px 20px; spacing: 12px; children: [prompt, entry]; }
prompt { enabled: true; text-color: @fg; }
entry { placeholder: "Search applications…"; placeholder-color: @muted; }
listview { lines: 7; fixed-height: true; scrollbar: false; spacing: 6px; }
element { padding: 12px 14px; border-radius: 0px; }
element selected.normal { background-color: @accent; text-color: #1d1d1f; }
element-text { vertical-align: 0.5; background-color: inherit; text-color: inherit; }
